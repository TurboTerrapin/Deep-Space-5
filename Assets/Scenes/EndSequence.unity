  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "    A NEW M-CLASS PLANET DISCOVERED 401 LIGHTYEARS FROM EARTH WILL BE
    NAMED IN HONOR OF SCC DIRECTOR AND FORMER ADMIRAL WALTER GILROY. THE PLANET COULD
    SUSTAIN LIFE IN THE FUTURE AND WOULD SERVE AS A BLANK SLATE FOR COLONIZATION
    EFFORTS. THE PLANET WAS IDENTIFIED USING A LONG-RANGE PROBE WITH SPECTRAL SENSORS.\n   
    GILROY GAVE A SHORT SPEECH DURING THE ANNOUNCEMENT BRIEFING: \"THIS IS THE GREATEST
    HONOR IN MY LIFETIME. WHEN I FIRST STEPPED FOOT ABOARD A STARSHIP, I ONLY HAD
    ASPIRATIONS OF EXPLORING THE GALAXY WITH MY CREWMATES. IT NEVER OCCURRED TO ME
    THAT I WOULD SOMEDAY REACH THE LEVEL OF SUCCESS AND NOTORIETY REQUIRED TO ACHIEVE
    THE STATUS OF ADMIRAL, DIRECTOR, AND NOW, TO BE IMMORTALIZED IN THIS MANNER.\"\n   
    GILROY IS EXPECTED TO VISIT THE PLANET PERSONALLY WITHIN THE NEXT YEAR AS PART
    OF AN EXCURSION MISSION ABOARD THE U.S.S. ENDURANCE.  "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d24b90a6427c83b4096d2d5ed236fac7, type: 2}
